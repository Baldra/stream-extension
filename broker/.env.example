# Token broker configuration.
#
# Copy to broker/.env and fill in real values:
#   cp broker/.env.example broker/.env
#
# `npm run broker` loads this file automatically. A variable that is already set in
# your real environment wins over this file, so a production deploy can inject
# secrets without changing the command.
#
# This file holds client secrets. Do not commit it.

# --- Provider credentials (secrets) -------------------------------------------
# Both values come from the provider's developer console and must match the client
# ids the extension was built with (see .env.example at the repository root).
TWITCH_CLIENT_ID=paste-twitch-client-id
TWITCH_CLIENT_SECRET=paste-twitch-client-secret
KICK_CLIENT_ID=paste-kick-client-id
KICK_CLIENT_SECRET=paste-kick-client-secret

# --- Who may call the broker ----------------------------------------------------
# The ORIGIN OF THE CALLER, not the broker's own address. The extension sends this
# as the CORS Origin header, so this must be `chrome-extension://<extension-id>`.
# Find the id on chrome://extensions after loading dist/ unpacked.
ALLOWED_ORIGINS=chrome-extension://abcdefghijklmnopabcdefghijklmnop

# The exact redirect_uri the extension sends, which the broker compares byte for
# byte. The extension calls chrome.identity.getRedirectURL(''), so the value is
# always the origin with a trailing slash and NO path:
#   https://<extension-id>.chromiumapp.org/
# Register the identical string in the Twitch and Kick developer consoles.
ALLOWED_REDIRECT_URIS=https://abcdefghijklmnopabcdefghijklmnop.chromiumapp.org/

# --- Local server ---------------------------------------------------------------
# For local development the broker listens on 8787, which pairs with
# BROKER_ORIGIN=http://localhost:8787 in the root .env.example. Use 0 to bind an
# ephemeral port.
PORT=8787
