# Extension build configuration.
#
# Copy to .env at the repository root and fill in the values:
#   cp .env.example .env
#
# `npm run build` and `npm run dev` load this file, and then broker/.env, before
# substituting these values into the bundle. A variable already present in your real
# environment wins over both files.
#
# Everything here is PUBLIC. These values are compiled into the extension and are
# visible to anyone who inspects it. Client secrets must never appear in this file;
# they belong only in broker/.env.

# Where the broker is reachable from the browser. This becomes a host permission, so
# it must match the address the broker actually listens on.
# For the local setup in broker/.env.example, that is:
BROKER_ORIGIN=http://localhost:8787

# Public OAuth client ids. These MUST equal TWITCH_CLIENT_ID and KICK_CLIENT_ID in
# broker/.env. A mismatch fails the code exchange upstream with an opaque error, so
# keeping both files in step is the one thing to check when a connect does not work.
# The broker's .env is read second, which is why the two can be left to a single
# source of truth: setting these here is optional, and omitting them falls back to
# the value in broker/.env.
TWITCH_CLIENT_ID=
KICK_CLIENT_ID=
