{
  "name": "stream-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chromium MV3 extension that notifies when followed Twitch and Kick channels go live",
  "scripts": {
    "build": "node --env-file-if-exists=.env --env-file-if-exists=broker/.env scripts/build.mjs",
    "build:broker": "node scripts/build-broker.mjs",
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=broker/.env scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "broker": "node --env-file-if-exists=broker/.env broker/dist/server.js",
    "broker:build": "npm run build:broker && npm run broker",
    "verify": "npm run typecheck && npm run test && npm run build && npm run build:broker"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "esbuild@0.21.5": true
  }
}
